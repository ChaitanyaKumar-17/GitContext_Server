# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# GitHub Personal Access Token (read-only scopes: repo, read:org)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Bearer token that MCP clients must present in the Authorization header.
# Generate a strong random value, e.g.:  python -c "import secrets; print(secrets.token_hex(32))"
MCP_BEARER_TOKEN=your-secret-token-here
